# BrainVolt local development environment (roadmap 1.2.3).
#
# Copy to `.env` (git-ignored) — `make up` does it automatically on first run.
# Docker Compose, the Makefile and `set -a; . ./.env; set +a` in Git Bash all
# read this file and expand ${VAR} references, so every credential is written
# exactly once. Values here are for local development only; never reuse them
# on a deployed server.

# --- Runtime -----------------------------------------------------------------
# dev | prod (prod forbids the Firebase emulator and demo- projects)
BRAINVOLT_ENV=dev
BRAINVOLT_HTTP_ADDR=:8080
# Host port of the api container (`make up-app`); stop it before `make run`.
BRAINVOLT_API_PORT=8080
# debug | info | warn | error
BRAINVOLT_LOG_LEVEL=debug
# text (readable, local) | json (deployed, the default when unset)
BRAINVOLT_LOG_FORMAT=text
# Cloud Run single service (D-096): the API also runs the worker jobs.
# Leave unset locally (make worker runs them); production sets it to true.
# BRAINVOLT_EMBED_WORKER=true

# Optional overrides; the values shown are the built-in defaults
# (docs/api/limits.md §3). Uncomment to change.
# BRAINVOLT_HTTP_READ_TIMEOUT=10s
# BRAINVOLT_HTTP_WRITE_TIMEOUT=15s
# BRAINVOLT_HTTP_IDLE_TIMEOUT=60s
# BRAINVOLT_HTTP_HANDLER_TIMEOUT=10s
# BRAINVOLT_HTTP_SHUTDOWN_TIMEOUT=20s
# BRAINVOLT_POSTGRES_STATEMENT_TIMEOUT=3s
# BRAINVOLT_POSTGRES_WORKER_STATEMENT_TIMEOUT=60s

# --- PostgreSQL 18 (docker-compose service `postgres`) -------------------------
BRAINVOLT_POSTGRES_USER=brainvolt
BRAINVOLT_POSTGRES_PASSWORD=brainvolt_dev_password
BRAINVOLT_POSTGRES_DB=brainvolt
BRAINVOLT_POSTGRES_PORT=5432
BRAINVOLT_POSTGRES_URL=postgres://${BRAINVOLT_POSTGRES_USER}:${BRAINVOLT_POSTGRES_PASSWORD}@localhost:${BRAINVOLT_POSTGRES_PORT}/${BRAINVOLT_POSTGRES_DB}?sslmode=disable
# Pool sizes and connection ages (D-098); defaults fit Supabase:
# BRAINVOLT_POSTGRES_MAX_CONNS=8
# BRAINVOLT_POSTGRES_JOBS_MAX_CONNS=3
# BRAINVOLT_POSTGRES_MAX_CONN_IDLE_TIME=1m
# BRAINVOLT_POSTGRES_MAX_CONN_LIFETIME=30m

# --- Redis 8.10 (docker-compose service `redis`) ------------------------------
BRAINVOLT_REDIS_PASSWORD=brainvolt_dev_password
BRAINVOLT_REDIS_PORT=6379
BRAINVOLT_REDIS_URL=redis://:${BRAINVOLT_REDIS_PASSWORD}@localhost:${BRAINVOLT_REDIS_PORT}/0

# --- Firebase (docker-compose service `firebase-auth`) ------------------------
# Locally the backend talks to the Auth Emulator with an offline "demo-"
# project, so test sign-ups never reach the real `brainvolt` project (D-014,
# ADR-0003). Deployed environments set the real project id (`brainvolt-a9caa`,
# D-061) and leave FIREBASE_AUTH_EMULATOR_HOST unset.
BRAINVOLT_FIREBASE_PROJECT_ID=demo-brainvolt
BRAINVOLT_FIREBASE_AUTH_EMULATOR_PORT=9099
# Standard name read by the Firebase Admin SDK itself (docs/api/conventions.md).
FIREBASE_AUTH_EMULATOR_HOST=localhost:${BRAINVOLT_FIREBASE_AUTH_EMULATOR_PORT}
# Push (FCM) from the worker: path to a service-account key of the real
# project with the "Firebase Cloud Messaging API Admin" role. Leave empty
# locally: pushes are then only written to the worker log (D-086).
BRAINVOLT_FCM_CREDENTIALS_FILE=

# --- Integration tests -------------------------------------------------------
# Used only by `go test` (make test). Tests never read the application URLs
# above; Redis tests use logical database 15 to stay apart from dev data.
BRAINVOLT_TEST_POSTGRES_URL=${BRAINVOLT_POSTGRES_URL}
BRAINVOLT_TEST_REDIS_URL=redis://:${BRAINVOLT_REDIS_PASSWORD}@localhost:${BRAINVOLT_REDIS_PORT}/15
BRAINVOLT_TEST_FIREBASE_AUTH_EMULATOR_HOST=localhost:${BRAINVOLT_FIREBASE_AUTH_EMULATOR_PORT}
