# https://editorconfig.org (roadmap 1.1.1)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,go.work}]
indent_style = tab
indent_size = 4

# Make requires tabs in recipes.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.sql]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
