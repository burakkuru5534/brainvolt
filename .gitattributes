# Line endings (repo-layout.md "Windows notes", roadmap 1.1.1).
# Everything is stored and checked out with LF so SQL, Go, shell and YAML
# files work unchanged inside Linux containers, even on a Windows host.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings, no textual diff.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.mp3    binary
*.wav    binary
*.ogg    binary
*.jar    binary
*.keystore binary
*.jks    binary

# Generated code: collapsed in diffs (still reviewed via `sqlc diff` / codegen checks in CI).
*.g.dart         linguist-generated=true
*.freezed.dart   linguist-generated=true
backend/**/sqlc/*.go linguist-generated=true
